# ==========================================
# Application Configuration
# ==========================================
APP_NAME="Dastavez Document Intelligence API"
APP_ENV="development"
DEBUG=false
API_V1_STR="/api/v1"
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173"

# ==========================================
# Supabase Configuration (DB, Auth, Storage)
# ==========================================
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret-at-least-32-chars"
SUPABASE_STORAGE_BUCKET="documents"

# ==========================================
# Qdrant Vector Search
# ==========================================
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY="your-qdrant-api-key"
QDRANT_COLLECTION_NAME="dastavez_chunks"

# ==========================================
# Sarvam AI (Indic OCR, STT, TTS, LLM)
# ==========================================
SARVAM_API_KEY="your-sarvam-api-key"
SARVAM_BASE_URL="https://api.sarvam.ai"
SARVAM_LLM_MODEL="sarvam-105b"
STT_MODEL_NAME="saaras-v3"
TTS_MODEL_NAME="bulbul-v3"

# ==========================================
# Hosted LLM & Embeddings
# ==========================================
LLM_PROVIDER="hosted"
LLM_API_KEY="your-llm-api-key"
LLM_BASE_URL="https://api.openai.com/v1"
LLM_MODEL_NAME="gpt-4o-mini"
EMBEDDING_MODEL_NAME="BAAI/bge-m3"
EMBEDDING_DIMENSION=1024

# ==========================================
# Ingestion & Chunking Parameters
# ==========================================
MAX_FILE_SIZE_BYTES=52428800
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=50
